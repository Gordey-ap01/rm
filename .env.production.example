APP_DOMAIN=rm.example.ru

DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=rm.example.ru,www.rm.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://rm.example.ru,https://www.rm.example.ru
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

POSTGRES_DB=rehab_center
POSTGRES_USER=rehab
POSTGRES_PASSWORD=CHANGE_ME_LONG_DATABASE_PASSWORD

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.ru
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=no-reply@example.ru
EMAIL_HOST_PASSWORD=CHANGE_ME_SMTP_PASSWORD
DEFAULT_FROM_EMAIL=no-reply@example.ru
